+#!/usr/bin/env python3
+"""Report only results from matching, fully executed emulator suites."""
+from pathlib import Path
+import base64, hashlib, html, json
+R=Path(__file__).resolve().parents[1]
+sha=hashlib.sha256((R/'rom/hexgl.j64').read_bytes()).hexdigest()
+core=json.loads((R/'test-results/summary.json').read_text())
+gui=json.loads((R/'test-results/gui/summary.json').read_text())
+assert all(x['status']=='PASS' and x['rom_sha256']==sha for x in [core,gui]),'Current ROM has not passed both complete suites'
+def image(path,caption):
+    b64=base64.b64encode(path.read_bytes()).decode()
+    return f'<figure><img src="data:image/png;base64,{b64}" alt="{html.escape(caption)}"><figcaption>{html.escape(caption)}</figcaption></figure>'
+def duration(ticks,hz):
+    ms=ticks*1000//hz
+    return f'{ms//60000:02d}:{ms//1000%60:02d}.{ms%1000:03d}'
+rows=''
+for video,hz in [('ntsc',60),('pal',50)]:
+    c=core['cases']['race-'+video]
+    rows+='<tr><td>'+video.upper()+'</td>'+''.join('<td>'+duration(t,hz)+'</td>' for t in [*c['lap_ticks'],c['race_ticks'],min(c['lap_ticks'])])+'</tr>'
+gui_path=R/'test-results/gui/no-bios-ntsc'
+gui_case=json.loads((gui_path/'result.json').read_text())
+picture=gui_path/'latest.png'
+for i,s in enumerate(gui_case['samples'],1):
+    p=gui_path/f'capture-{i:03d}.png'
+    if s['phase']=='throttle-autopilot' and p.exists():picture=p;break
+verdicts=''
+for group,summary in [('Desktop',gui),('Core',core)]:
+    for name,c in summary['cases'].items():
+        status=c.get('status','EXPECTED_FAILURE' if 'expected_failure_detected' in c else 'PASS')
+        desc=c.get('detected',c.get('expected_failure_detected',', '.join(c.get('checks',[]))))
+        verdicts+=f'<tr><td>{group}: {html.escape(name)}</td><td>{status}</td><td>{html.escape(desc)}</td></tr>'
+page=f'''<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HexGL Jaguar — ship and camera milestone</title><style>
+*{{box-sizing:border-box}}body{{margin:0;background:#10191f;color:#e6eef3;font:16px/1.65 system-ui,sans-serif}}main{{max-width:1100px;margin:auto;padding:45px 24px}}h1{{font-size:48px;line-height:1.1;margin:18px 0}}h2{{margin:36px 0 14px}}.tag{{color:#71dfc5;font-size:12px;letter-spacing:2px}}.lead{{font-size:21px;color:#b9cbd6}}.notice{{background:#2b271f;border-left:3px solid #e9b657;padding:16px 20px}}.ok{{background:#18372f;padding:16px;color:#a5ebce}}.shots{{display:grid;grid-template-columns:1fr 1fr;gap:18px}}figure{{margin:0;background:#1b2a34}}img{{width:100%;display:block;image-rendering:pixelated}}figcaption{{padding:12px;font-size:13px}}table{{width:100%;border-collapse:collapse;font-size:13px}}th,td{{text-align:left;vertical-align:top;padding:10px;border-bottom:1px solid #354852}}.scroll{{overflow:auto}}code,pre{{font:13px/1.7 ui-monospace,monospace;overflow-wrap:anywhere;white-space:pre-wrap}}pre{{padding:18px;background:#1b2a34}}footer{{margin-top:36px;border-top:1px solid #354852;padding-top:18px;color:#a5b9c5;font-size:13px}}li{{margin:8px 0}}@media(max-width:650px){{.shots{{grid-template-columns:1fr}}h1{{font-size:36px}}td,th{{padding:8px 4px}}}}</style>
+<main><div class="tag">NATIVE JAGUAR DEVELOPMENT · SHIP AND CAMERA · 2026-10-15</div><h1>Bank into the turn.<br>Let the camera follow.</h1><p class="lead">The next native milestone adds steering bank, speed-sensitive camera distance and filtered terrain-height following—while retaining the race flow and regression gate.</p><div class="ok"><strong>Both complete emulator suites passed.</strong> Desktop and core reports match this ROM's SHA-256. Twenty-one watchdog, formatting and motion unit tests also passed.</div>
+<h2>New in this build</h2><ul><li><strong>Ship bank:</strong> filtered left/right roll on the original ship and attached booster; approximately 34° normal bank and 58° with B held while steering. Release returns toward level.</li><li><strong>Speed-sensitive chase:</strong> the existing 160-unit trail distance smoothly extends by up to 40 units at maximum speed, then returns when braking.</li><li><strong>Terrain-height filtering:</strong> the camera follows map height changes with a bounded filter rather than snapping to every sample. Safety limits keep it above the ship and within the tested framing.</li><li><strong>State handling:</strong> pause freezes the actual renderer pose, restart clears all motion state, and countdown/finish behavior remains intact.</li><li><strong>Independent checks:</strong> tests read the actual ship/booster angles and renderer camera, compare them with a fixed-point reference, and continue checking visible output.</li></ul>
+<h2>Actual emulator output</h2><div class="shots">{image(R/'test-results/bank-ntsc'/('frame_%05d.png'%core['cases']['bank-ntsc']['capture_fields']['left']),'Actual Virtual Jaguar output: steering bank')}{image(R/'test-results/bank-ntsc'/('frame_%05d.png'%core['cases']['bank-ntsc']['capture_fields']['airbrake']),'Actual Virtual Jaguar output: stronger airbrake bank')}</div><p>Images are actual emulator captures. The mesh rotation and camera follow run in Jaguar GPU assembly, not a host-side overlay. This is an adaptation of original roll and speed-offset behavior, not full quaternion/physics or CameraChase parity.</p>
+<h2>Motion checks</h2><p>The stationary steering tests isolate left/right bank, release, both airbrake directions, pause and restart. Acceleration/braking tests require intermediate camera distances rather than a snap. The complete races verify hundreds of filtered height updates, both bank directions and unchanged lap/result behavior.</p><p>PAL and NTSC use elapsed-field response coefficients. A committed-pose sequence prevents a partially updated frame from being mistaken for a completed pose. The numerical checks independently validate each filter recurrence and read the real mesh angles/camera addresses from assembler exports.</p><h2>Executed three-lap results</h2><p>These are separate automated races, not equivalent performance benchmarks: the existing waypoint autopilot advances per rendered update. The clocks themselves use actual video fields.</p><div class="scroll"><table><tr><th>Video</th><th>Lap 1</th><th>Lap 2</th><th>Lap 3</th><th>Total</th><th>Best</th></tr>{rows}</table></div><p>The tests require the three raw lap times to sum exactly to the total, verify the displayed splits and best lap, and observe 180 additional video fields after the finish.</p>
+<h2>Executed validation</h2><div class="scroll"><table><tr><th>Scenario</th><th>Verdict</th><th>Checks / detected fault</th></tr>{verdicts}</table></div><p>Countdown/results can legitimately be static. The watchdog now checks motion only during active movement, while retaining continuous brightness and heartbeat requirements in every phase. It still rejects deliberately frozen video even when game telemetry advances.</p>
+<h2>Build, test and play</h2><pre>make rom       # compile GPU, DSP and 68000 entry, package cartridge
+make test      # unit tests + full core and stock desktop regression suites
+make release   # only package after matching-ROM passes</pre><pre>virtualjaguar rom/hexgl.j64 --ntsc --gpu --dsp</pre><p>Stock keyboard defaults: <strong>L</strong> begin countdown/thrust, <strong>J</strong> optional autopilot, <strong>Z/C</strong> steering, <strong>K</strong> brake, <strong>P</strong> pause, <strong>O</strong> restart. BIOS-on and BIOS-off remain supported in the tested emulator.</p>
+<h2>Artifact</h2><p><code>rom/hexgl.j64 — 6,291,456 bytes<br>SHA-256: {sha}</code></p><p>Sources and behavior mapping: <code>docs/SHIP-AND-CAMERA.md</code>.<br>Evidence: <code>test-results/summary.json</code> and <code>test-results/gui/summary.json</code>.<br>Stock desktop executable: {html.escape(gui['emulator_version'])}.</p><div class="notice"><strong>Still an incomplete HexGL port.</strong> The camera retains native framing and yaw-only orientation; height smoothing is an explicit native adaptation. Lateral drift/repulsion, hover/fall dynamics, slope pitch, original look-at/up-vector and orbit behavior remain unfinished, as do bitmap HUD/menus, effects, recording/replay, leaderboards and EEPROM persistence. See docs/PARITY.md.</div><footer>Timing resolution is one video field; the three-digit millisecond display does not imply a millisecond hardware timer. Finite emulator tests cannot guarantee every configuration/input sequence. Physical hardware and remotely executed CI are not claimed. Upstream licensing notices remain in NOTICE.md.</footer></main></html>'''
+(R/'REPORT.html').write_text(page)
+md=f'# Ship and camera milestone: executed tests\n\nROM SHA-256: `{sha}`\n\nBoth full suites: **PASS**. Positive scenarios ran fresh.\n\n'
+for title,s in [('Stock desktop GUI',gui),('Virtual Jaguar Rx core',core)]:md+='## '+title+'\n\n```json\n'+json.dumps(s,indent=2)+'\n```\n\n'
+md+='21 unit tests: PASS (test-results/unit-tests.log). Physical hardware and remote CI untested.\n'
+(R/'docs/TEST-RESULTS.md').write_text(md)
+print(R/'REPORT.html')
