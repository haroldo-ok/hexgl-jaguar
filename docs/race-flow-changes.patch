+; Native race-flow presentation derived from BKcore HexGL Gameplay.js.
+; Gameplay.js by Thibaut Despoulain: CC BY-NC 3.0; see NOTICE.md.
+; Original bitmap HUD is still unported. Times are MM:SS.mmm at video-field precision.
+; All strings below are read through their DRAM backing address.
+
+MACRO HUDSTRING
+ movei #\0-MODrun_control+MODstart_control,r0
+ movei #\1,r1
+ movei #PrintString_YX,r2
+ BL (r2)
+ENDM
+
+draw_race_hud:
+ PUSHLR
+ HUDSTRING status_line,1<<16
+ movei #GAME,r14
+ load (r14+32),r0
+ moveq #10,r1
+ mult r1,r0
+ movei #1<<16|12,r1
+ movei #print_three,r2
+ BL (r2)
+ movei #GAME,r14
+ load (r14+36),r0
+ movei #1<<16|24,r1
+ movei #print_three,r2
+ BL (r2)
+ movei #GAME,r14
+ load (r14+40),r0
+ cmpq #4,r0
+ jr ne,.lapok
+ nop
+ moveq #3,r0
+.lapok
+ movei #1<<16|34,r1
+ movei #PrintDEC2_YX,r2
+ BL (r2)
+ HUDSTRING time_line,2<<16
+ movei #GAME,r14
+ load (r14+64),r0
+ movei #2<<16|5,r1
+ movei #print_time,r2
+ BL (r2)
+ movei #GAME,r14
+ load (r14+64),r0
+ load (r14+84),r2
+ sub r2,r0
+ load (r14+8),r2
+ cmpq #3,r2
+ jr ne,.currentlap
+ nop
+ load (r14+96),r0
+.currentlap
+ movei #2<<16|19,r1
+ movei #print_time,r2
+ BL (r2)
+ movei #GAME,r14
+ load (r14+100),r0
+ movei #2<<16|34,r1
+ movei #print_time,r2
+ BL (r2)
+ HUDSTRING laps_line,3<<16
+ movei #GAME,r14
+ load (r14+88),r0
+ movei #3<<16|3,r1
+ movei #print_time,r2
+ BL (r2)
+ movei #GAME,r14
+ load (r14+92),r0
+ movei #3<<16|18,r1
+ movei #print_time,r2
+ BL (r2)
+ movei #GAME,r14
+ load (r14+96),r0
+ movei #3<<16|33,r1
+ movei #print_time,r2
+ BL (r2)
+ ; Select status and message independently of numerical telemetry.
+ movei #GAME,r14
+ movei #ready_word-MODrun_control+MODstart_control,r21
+ movei #help_text-MODrun_control+MODstart_control,r22
+ load (r14+8),r0
+ cmpq #0,r0
+ movei #hud_status,r2
+ jump eq,(r2)
+ nop
+ cmpq #4,r0
+ movei #hud_countdown,r1
+ jump eq,(r1)
+ nop
+ movei #dead_word-MODrun_control+MODstart_control,r21
+ movei #dead_message-MODrun_control+MODstart_control,r22
+ cmpq #2,r0
+ jump eq,(r2)
