+ movei #finish_word-MODrun_control+MODstart_control,r21
+ movei #finish_message-MODrun_control+MODstart_control,r22
+ cmpq #3,r0
+ jump eq,(r2)
+ nop
+ movei #race_word-MODrun_control+MODstart_control,r21
+ movei #help_text-MODrun_control+MODstart_control,r22
