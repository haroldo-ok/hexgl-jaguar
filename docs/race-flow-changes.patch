+; r0 unsigned field count, r1 y:x. Formatter scratch is DRAM, not GPU local RAM.
+print_time:
+ PUSHLR r20,r21,r22,r23,r24
+ move r1,r24
+ movei #GAME+80,r2
+ load (r2),r2
+ move r0,r20
+ div r2,r0
+ move r0,r21 ; total seconds
+ mult r0,r2
+ sub r2,r20
+ movei #1000,r2
+ mult r2,r20
+ movei #GAME+80,r2
+ load (r2),r2
+ div r2,r20 ; fractional milliseconds, truncated
+ movei #60,r2
+ div r2,r0
+ move r0,r22 ; minutes
+ mult r0,r2
+ sub r2,r21 ; seconds
+ movei #100,r2
+ div r2,r0
+ mult r0,r2
+ sub r2,r22 ; minutes modulo 100, fixed-width display
+ ; Keep each formatted time at a distinct observable DRAM address.
+ move r24,r23
+ shrq #16,r23
+ subq #2,r23
+ shlq #6,r23
+ move r24,r1
+ shlq #16,r1
+ shrq #16,r1
+ add r1,r23
+ movei #$1200,r1
+ add r1,r23
+ PUSH r23
+ move r22,r0
+ movei #emit_two,r3
+ BL (r3)
+ movei #58,r0
+ storeb r0,(r23)
+ addq #1,r23
+ move r21,r0
+ movei #emit_two,r3
+ BL (r3)
+ movei #46,r0
+ storeb r0,(r23)
+ addq #1,r23
+ move r20,r0
+ movei #emit_three,r3
+ BL (r3)
+ moveq #0,r0
+ storeb r0,(r23)
+ POP r0
+ move r24,r1
+ movei #PrintString_YX,r2
+ BL (r2)
+ POPLR r20,r21,r22,r23,r24
+
+print_three:
+ PUSHLR r23,r24
+ move r1,r24
+ movei #$1200,r23
+ movei #emit_three,r3
+ BL (r3)
+ moveq #0,r0
+ storeb r0,(r23)
+ movei #$1200,r0
+ move r24,r1
+ movei #PrintString_YX,r2
+ BL (r2)
+ POPLR r23,r24
+
+emit_three:
+ movei #100,r1
+ move r0,r2
+ div r1,r0
+ mult r0,r1
+ sub r1,r2
+ addq #24,r0
+ addq #24,r0
+ storeb r0,(r23)
+ addq #1,r23
+ move r2,r0
+emit_two:
+ moveq #10,r1
+ move r0,r2
+ div r1,r0
+ mult r0,r1
+ sub r1,r2
+ addq #24,r0
+ addq #24,r0
+ storeb r0,(r23)
+ addq #1,r23
+ addq #24,r2
+ addq #24,r2
+ storeb r2,(r23)
+ jump (LR)
+ addq #1,r23
+
+ align 4
+status_line: dc.b "        SPD      SHIELD       LAP   /3         ",0
+time_line: dc.b   "TIME           LAP           BEST              ",0
+laps_line: dc.b   "1:             2:             3:               ",0
