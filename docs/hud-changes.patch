+#!/usr/bin/env python3
+"""Current bitmap-HUD milestone: only render matching-ROM executed evidence."""
+from pathlib import Path
+import base64,hashlib,html,json
+R=Path(__file__).resolve().parents[1]
+sha=hashlib.sha256((R/'rom/hexgl.j64').read_bytes()).hexdigest()
+core=json.loads((R/'test-results/summary.json').read_text())
+gui=json.loads((R/'test-results/gui/summary.json').read_text())
+hud=json.loads((R/'test-results/hud-summary.json').read_text())
+assert all(x['status']=='PASS' and x['rom_sha256']==sha for x in [core,gui,hud])
+unit=(R/'test-results/unit-tests.log').read_text();assert 'Ran 31 tests' in unit and '\nOK' in unit
+
+def image(path,caption):
+    b64=base64.b64encode(path.read_bytes()).decode()
+    return f'<figure><img src="data:image/png;base64,{b64}" alt="{html.escape(caption)}"><figcaption>{html.escape(caption)}</figcaption></figure>'
+
+c=hud['cases']['ntsc']['bitmap_hud']['captures']
+shots=''
+for item,caption in [(next(v for v in c if 0<v['speed']<28),'Partial speed'),(next(v for v in c if v['speed']==28),'Full speed'),(next(v for v in c if 0<v['shield']<100),'Collision damage'),(c[-1],'Reset: full shield, zero speed')]:
+    shots+=image(R/'test-results/hud-live-ntsc'/item['capture'],f"{caption} — speed {item['speed']*10:03d}, shield {item['shield']:03d}; {item['pixels']} exact pixels checked")
+rows=''
+for group,summary in [('Core',core),('Stock desktop',gui),('Live gauges',hud)]:
+    for name,c in summary['cases'].items():
+        status=c.get('status','EXPECTED FAILURE DETECTED' if 'expected_failure_detected' in c else 'PASS')
